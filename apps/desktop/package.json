{
  "name": "@shanhai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "山海桌面端（Electron 壳）：主进程 boot host + IPC + React 流式渲染",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsup && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "start": "electron .",
    "test:browser-e2e": "esbuild scripts/browser-e2e.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/browser-e2e.cjs && electron dist/browser-e2e.cjs"
  },
  "dependencies": {
    "@shanhai/browser-use": "workspace:*",
    "@shanhai/runtime": "workspace:*",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
