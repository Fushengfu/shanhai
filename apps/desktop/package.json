{
  "name": "@shanhai/desktop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "type": "module",
  "description": "山海桌面端（Electron 壳）：主进程 boot host + IPC + React 流式渲染",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsup && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "start": "electron .",
    "dist:mac": "npm run build && electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --config.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test:browser-e2e": "esbuild scripts/browser-e2e.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/browser-e2e.cjs && electron dist/browser-e2e.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.27.7",
    "node-pty": "^1.0.0",
    "tesseract.js": "^7.0.0",
    "vite": "^5.4.21",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "^0.27.7",
    "@esbuild/linux-arm64": "^0.27.7",
    "@esbuild/linux-x64": "^0.27.7",
    "@esbuild/win32-arm64": "^0.27.7",
    "@esbuild/win32-x64": "^0.27.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@shanhai/browser-use": "workspace:*",
    "@shanhai/kernel-modules": "workspace:*",
    "@shanhai/runtime": "workspace:*",
    "@shanhai/terminal": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
