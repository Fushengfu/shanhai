{
  "name": "@shanhai/skills",
  "version": "0.1.0",
  "type": "module",
  "description": "山海复合技能（Skill）：技能注册/扫描/读取 + skill_list/skill_read 工具",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "gen:protocol": "node scripts/gen-plugin-protocol.mjs",
    "build": "node scripts/gen-plugin-protocol.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shanhai/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
