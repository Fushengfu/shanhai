{
  "name": "@shanhai/browser-use",
  "version": "0.1.0",
  "type": "module",
  "description": "山海操作浏览器（browser-use）：BrowserUseService（navigate/click/type/evaluate/screenshot/network/cookies）+ Electron WebContentsView 后端",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shanhai/skills": "workspace:*",
    "@shanhai/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
