{
  "name": "@shanhai/deepseek-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "山海 DeepSeek 网页版桥接：把已登录的 DeepSeek 网页版封装成 OpenAI 兼容 /v1/chat/completions，自包含 ReAct 工具循环",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shanhai/llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
